[Unit]
Description=Creator tracker off-host heartbeat
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=creator-tracker-health
Group=creator-tracker-health
StateDirectory=creator-tracker-monitor
StateDirectoryMode=0700
WorkingDirectory=/opt/creator-tracker-monitor
Environment=CREATOR_TRACKER_MONITOR_ENDPOINT=https://gotall-creator-platform.vercel.app/api/v1/creator-tracker/heartbeat
LoadCredential=monitor-secret:/etc/creator-tracker-monitor/monitor-secret
LoadCredential=role-env:/etc/creator-tracker/credentials/check-coverage.env
ExecStart=/opt/creator-tracker/node/v24.20.0/bin/node /opt/creator-tracker-monitor/reporter.mjs
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
PrivateMounts=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=all
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
ReadOnlyPaths=/opt/creator-tracker
BindReadOnlyPaths=/var/lib/creator-tracker/state/collector-worker
BindReadOnlyPaths=/var/lib/creator-tracker/state/scheduler-tick
BindReadOnlyPaths=/var/lib/creator-tracker/state/instagram-discovery
BindReadOnlyPaths=/var/lib/creator-tracker/state/instagram-scheduler
BindReadOnlyPaths=/var/lib/creator-tracker/state/provider-reconcile
BindReadOnlyPaths=/var/lib/creator-tracker/state/canonical-delivery
BindReadOnlyPaths=/var/lib/creator-tracker/state/raw-verifier
BindReadOnlyPaths=/var/lib/creator-tracker/state/dashboard-health
BindReadOnlyPaths=/var/lib/creator-tracker-autopilot-health
InaccessiblePaths=-/var/lib/creator-tracker-autopilot
