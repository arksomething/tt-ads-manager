# Copy to ~/.config/creator-tracker/env with mode 0600 only after the V2
# executables exist. Values must be absolute paths to executable wrapper files.
# Do not put inline commands, arguments, tokens, passwords, or API keys here.

CREATOR_TRACKER_ROSTER_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/discover
CREATOR_TRACKER_SCHEDULER_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/observe-and-finalize
# Keep these unset until SCRAPECREATORS_API_KEY exists in GoTall's owner-only
# .env.local and the documented single-account smoke test has passed.
# CREATOR_TRACKER_INSTAGRAM_DISCOVERY_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/discover-instagram
# CREATOR_TRACKER_INSTAGRAM_SCHEDULER_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/observe-instagram-and-finalize
CREATOR_TRACKER_PROVIDER_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/provider-reconcile
CREATOR_TRACKER_WORKER_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/dashboard
CREATOR_TRACKER_COVERAGE_EXECUTABLE=/home/ark296/projects/gotall-viral-dash/ops/owned-tracker/check-coverage

# This is a path, not a credential value. The target must be an explicit,
# canonical, owner-only file containing VIRAL_APP_BASE_URL/API_KEY.
VIRAL_APP_CREDENTIALS_PATH=/home/ark296/projects/tt-ads-manager/web/.env

# Dashboard endpoint expected to return the status code below. Prefer a narrow,
# non-secret health endpoint. Multiple acceptable codes may be comma-separated.
CREATOR_TRACKER_DASHBOARD_HEALTH_URL=http://127.0.0.1:4410/api/health
CREATOR_TRACKER_DASHBOARD_EXPECTED_CODES=200
CREATOR_TRACKER_DASHBOARD_TIMEOUT_SECONDS=15

# Health freshness thresholds. The dashboard probe fails if any required marker
# is missing or older than its threshold.
CREATOR_TRACKER_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
CREATOR_TRACKER_SCHEDULER_SUCCESS_MAX_AGE_SECONDS=600
CREATOR_TRACKER_ROSTER_SUCCESS_MAX_AGE_SECONDS=5400
CREATOR_TRACKER_INSTAGRAM_SCHEDULER_SUCCESS_MAX_AGE_SECONDS=600
CREATOR_TRACKER_INSTAGRAM_DISCOVERY_SUCCESS_MAX_AGE_SECONDS=5400
CREATOR_TRACKER_PROVIDER_SUCCESS_MAX_AGE_SECONDS=50400

# The generic wrapper refreshes the current status file at this cadence while a
# command is running. Keep it shorter than the worker heartbeat threshold.
CREATOR_TRACKER_HEARTBEAT_INTERVAL_SECONDS=30
