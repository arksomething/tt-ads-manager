# Copy to ~/.config/creator-tracker/env with mode 0600. Executable paths are
# deliberately absent: the sealed supervisor maps each systemd role to the
# root-owned /opt/creator-tracker/current release and ignores mutable executable
# environment values. Do not put inline commands, tokens, passwords, or API
# keys here.

# This is a path, not a credential value. The target must be an explicit,
# canonical, owner-only file containing VIRAL_APP_BASE_URL/API_KEY.
VIRAL_APP_CREDENTIALS_PATH=/home/ark296/projects/tt-ads-manager/web/.env

# Dashboard endpoint expected to return the status code below. Prefer a narrow,
# non-secret health endpoint. Multiple acceptable codes may be comma-separated.
CREATOR_TRACKER_DASHBOARD_HEALTH_URL=http://127.0.0.1:4410/api/health
CREATOR_TRACKER_DASHBOARD_EXPECTED_CODES=200
CREATOR_TRACKER_DASHBOARD_TIMEOUT_SECONDS=15

# Health freshness thresholds. The dashboard probe fails if any required marker
# is missing or older than its threshold.
CREATOR_TRACKER_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
CREATOR_TRACKER_SCHEDULER_SUCCESS_MAX_AGE_SECONDS=600
CREATOR_TRACKER_ROSTER_SUCCESS_MAX_AGE_SECONDS=5400
CREATOR_TRACKER_INSTAGRAM_SCHEDULER_SUCCESS_MAX_AGE_SECONDS=660
CREATOR_TRACKER_INSTAGRAM_DISCOVERY_SUCCESS_MAX_AGE_SECONDS=5400
CREATOR_TRACKER_PROVIDER_SUCCESS_MAX_AGE_SECONDS=50400
CREATOR_TRACKER_CANONICAL_DELIVERY_SUCCESS_MAX_AGE_SECONDS=300
CREATOR_TRACKER_RAW_VERIFIER_SUCCESS_MAX_AGE_SECONDS=900
CREATOR_TRACKER_STORAGE_MIN_FREE_BYTES=21474836480

# The generic wrapper refreshes the current status file at this cadence while a
# command is running. Keep it shorter than the worker heartbeat threshold.
CREATOR_TRACKER_HEARTBEAT_INTERVAL_SECONDS=30
