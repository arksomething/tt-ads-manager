[Unit]
Description=Verify and seal creator tracker raw evidence
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=30min
# Six calendar ticks fit in this window. Keep two additional starts for the
# bounded on-failure retry path without rate-limiting a healthy five-minute job.
StartLimitBurst=8

[Service]
Type=oneshot
User=creator-tracker-raw-verifier
Group=creator-tracker-raw-verifier
Slice=creator-tracker.slice
WorkingDirectory=/opt/creator-tracker/current/app
EnvironmentFile=/etc/creator-tracker/runtime/raw-verifier.env
LoadCredential=role-env:/etc/creator-tracker/credentials/raw-verifier.env
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV SHELLOPTS BASHOPTS BASH_LOADABLES_PATH NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME PYTHONSTARTUP PERL5OPT PERL5LIB RUBYOPT RUBYLIB GCONV_PATH TSX_TSCONFIG_PATH CREATOR_TRACKER_RUNTIME_DIR CREATOR_TRACKER_STATE_DIR CREATOR_TRACKER_TEST_ONLY_ALLOW_ARBITRARY_COMMAND CREATOR_TRACKER_TEST_ONLY_SKIP_COVERAGE
ExecStart=/bin/bash --noprofile --norc -p -- /opt/creator-tracker/current/bin/run-contained-job raw-verifier
TimeoutStartSec=15min
SuccessExitStatus=75
Restart=on-failure
RestartSec=2min
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
PrivateMounts=true
ProtectHome=tmpfs
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
TemporaryFileSystem=/run:ro
BindPaths=/run/creator-tracker/locks
BindReadOnlyPaths=/run/systemd/resolve
BindPaths=/var/lib/creator-tracker/state/raw-verifier
InaccessiblePaths=/var/lib/creator-tracker/imports
BindReadOnlyPaths=/var/lib/creator-tracker/raw-evidence-v1
BindPaths=/var/lib/creator-tracker/verified-raw-evidence-v1
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
