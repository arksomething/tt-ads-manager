[Unit]
Description=Creator tracker roster refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=creator-tracker-writer
Group=creator-tracker-writer
Slice=creator-tracker.slice
WorkingDirectory=/opt/creator-tracker/current/app
EnvironmentFile=/etc/creator-tracker/runtime/roster-refresh.env
LoadCredential=role-env:/etc/creator-tracker/credentials/roster-refresh.env
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV SHELLOPTS BASHOPTS BASH_LOADABLES_PATH NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME PYTHONSTARTUP PERL5OPT PERL5LIB RUBYOPT RUBYLIB GCONV_PATH TSX_TSCONFIG_PATH CREATOR_TRACKER_RUNTIME_DIR CREATOR_TRACKER_STATE_DIR CREATOR_TRACKER_TEST_ONLY_ALLOW_ARBITRARY_COMMAND CREATOR_TRACKER_TEST_ONLY_SKIP_COVERAGE
ExecStart=/bin/bash --noprofile --norc -p -- /opt/creator-tracker/current/bin/run-contained-job roster-refresh
TimeoutStartSec=20min
SuccessExitStatus=75
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
PrivateMounts=true
ProtectHome=tmpfs
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
TemporaryFileSystem=/run:ro
BindPaths=/run/creator-tracker/locks
BindReadOnlyPaths=/run/systemd/resolve
BindPaths=/var/lib/creator-tracker/state/roster-refresh
BindPaths=/var/lib/creator-tracker/raw-evidence-v1
BindPaths=/var/lib/creator-tracker/state
InaccessiblePaths=/var/lib/creator-tracker/imports
InaccessiblePaths=/var/lib/creator-tracker/verified-raw-evidence-v1
ProtectProc=invisible
ProcSubset=all
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
