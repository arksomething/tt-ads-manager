[Unit]
Description=Creator tracker loopback dashboard worker
StartLimitIntervalSec=5min
StartLimitBurst=8

[Service]
Type=simple
User=creator-tracker-dashboard
Group=creator-tracker-dashboard
Slice=creator-tracker.slice
WorkingDirectory=/opt/creator-tracker/current/app
EnvironmentFile=/etc/creator-tracker/runtime/collector-worker.env
LoadCredential=role-env:/etc/creator-tracker/credentials/collector-worker.env
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV SHELLOPTS BASHOPTS BASH_LOADABLES_PATH NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME PYTHONSTARTUP PERL5OPT PERL5LIB RUBYOPT RUBYLIB GCONV_PATH TSX_TSCONFIG_PATH CREATOR_TRACKER_RUNTIME_DIR CREATOR_TRACKER_STATE_DIR CREATOR_TRACKER_TEST_ONLY_ALLOW_ARBITRARY_COMMAND CREATOR_TRACKER_TEST_ONLY_SKIP_COVERAGE
ExecStart=/bin/bash --noprofile --norc -p -- /opt/creator-tracker/current/bin/run-contained-job collector-worker
Restart=always
RestartSec=15s
TimeoutStopSec=45s
KillMode=control-group
OOMPolicy=stop
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
PrivateMounts=true
ProtectHome=tmpfs
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
TemporaryFileSystem=/run:ro
BindPaths=/run/creator-tracker/locks
BindPaths=/var/lib/creator-tracker/state/collector-worker
InaccessiblePaths=/var/lib/creator-tracker/imports
InaccessiblePaths=/var/lib/creator-tracker/raw-evidence-v1
InaccessiblePaths=/var/lib/creator-tracker/verified-raw-evidence-v1
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
