{
  "version": 1,
  "policy": {
    "ownerOnly": true,
    "maximumFileMode": "0600",
    "neverPrintValues": true,
    "productionWebAuthority": "Vercel encrypted environment variables",
    "collectorAuthority": "owner-only laptop files loaded with least privilege"
  },
  "sources": [
    {
      "id": "legacy-web-core",
      "kind": "dotenv",
      "path": "${HOME}/projects/tt-ads-manager/web/.env",
      "expectedVariables": [
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_PK",
        "SUPABASE_SK",
        "VIRAL_APP_BASE_URL",
        "VIRAL_APP_API_KEY"
      ]
    },
    {
      "id": "legacy-web-integrations",
      "kind": "dotenv",
      "path": "${HOME}/projects/tt-ads-manager/web/.env.local",
      "expectedVariables": [
        "AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "TIKTOK_APP_ID",
        "TIKTOK_SECRET",
        "TIKTOK_REDIRECT",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "SINGULAR_API_KEY",
        "SUPERWALL_API_KEY",
        "ADAPTY_DASHBOARD_TOKEN",
        "VIEWSBASE_SESSION_COOKIE_VALUE"
      ]
    },
    {
      "id": "vercel-production-pull-root",
      "kind": "dotenv",
      "path": "${HOME}/projects/tt-ads-manager/.vercel/.env.production.local",
      "expectedVariables": [
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AUTH_SECRET",
        "VIRAL_APP_API_KEY"
      ]
    },
    {
      "id": "vercel-production-pull-web",
      "kind": "dotenv",
      "path": "${HOME}/projects/tt-ads-manager/web/.vercel/.env.production.local",
      "expectedVariables": [
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AUTH_SECRET",
        "VIRAL_APP_API_KEY"
      ]
    },
    {
      "id": "owned-collector",
      "kind": "dotenv",
      "path": "${HOME}/projects/gotall-viral-dash/.env.local",
      "expectedVariables": [
        "VIRAL_DB_PATH",
        "SCRAPECREATORS_API_KEY",
        "TIKTOK_ADS_ACCESS_TOKEN",
        "TIKTOK_ADS_ADVERTISER_ID"
      ]
    },
    {
      "id": "collector-host-config",
      "kind": "dotenv",
      "path": "${HOME}/.config/creator-tracker/env",
      "containsSecrets": false,
      "expectedVariables": [
        "CREATOR_TRACKER_ROSTER_EXECUTABLE",
        "CREATOR_TRACKER_SCHEDULER_EXECUTABLE",
        "CREATOR_TRACKER_PROVIDER_EXECUTABLE",
        "CREATOR_TRACKER_WORKER_EXECUTABLE",
        "CREATOR_TRACKER_COVERAGE_EXECUTABLE",
        "VIRAL_APP_CREDENTIALS_PATH"
      ]
    },
    {
      "id": "legacy-discord-bot",
      "kind": "dotenv",
      "path": "${HOME}/projects/archive/gotall-discord-bot/.env",
      "expectedVariables": [
        "DISCORD_CLIENT_ID",
        "DISCORD_TOKEN"
      ]
    },
    {
      "id": "transactional-email",
      "kind": "dotenv",
      "path": "${HOME}/projects/gotall/.env",
      "expectedVariables": [
        "RESEND_API_KEY"
      ]
    },
    {
      "id": "product-analytics",
      "kind": "dotenv",
      "path": "${HOME}/projects/gotall/.env.local",
      "expectedVariables": [
        "POSTHOG_HOST",
        "POSTHOG_PROJECT_TOKEN"
      ]
    },
    {
      "id": "gotall-landing-supabase",
      "kind": "dotenv",
      "path": "${HOME}/projects/gotall-landing/.env",
      "expectedVariables": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    {
      "id": "hyperspeed-runtime",
      "kind": "dotenv",
      "path": "${HOME}/projects/hyperspeed/.env",
      "expectedVariables": [
        "OPENAI_API_KEY",
        "POST_BRIDGE_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY"
      ]
    },
    {
      "id": "cloudflare-api",
      "kind": "dotenv",
      "path": "${HOME}/projects/billionviews/.env.cloudflare.local",
      "expectedVariables": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN"
      ]
    },
    {
      "id": "vercel-cli-auth",
      "kind": "credentialFile",
      "path": "${HOME}/.local/share/com.vercel.cli/auth.json"
    },
    {
      "id": "cloudflare-wrangler-auth",
      "kind": "credentialFile",
      "path": "${HOME}/.config/.wrangler/config/default.toml"
    },
    {
      "id": "github-cli-auth",
      "kind": "credentialFile",
      "path": "${HOME}/.config/gh/hosts.yml"
    },
    {
      "id": "hyperspeed-vps-deploy-key",
      "kind": "credentialFile",
      "path": "${HOME}/.ssh/github_actions_deploy"
    }
  ],
  "platformRequirements": [
    {
      "area": "creator-web-core",
      "state": "available",
      "notes": "Existing Postgres, Supabase server access, and auth secrets are available. Production remains authoritative in Vercel."
    },
    {
      "area": "domain-and-hosting",
      "state": "available",
      "notes": "Cloudflare API, Vercel CLI, and Hyperspeed VPS SSH access are present."
    },
    {
      "area": "source-control",
      "state": "missing-user-session",
      "missing": [
        "valid GitHub CLI or Git HTTPS authentication for arksomething"
      ],
      "notes": "The stored GitHub CLI and HTTPS credentials are rejected, and SSH authentication is not registered. Local commits cannot be pushed until interactive reauthentication."
    },
    {
      "area": "tiktok-owned-tracking",
      "state": "in-progress",
      "notes": "Public collector/runtime work is being handled separately. Existing TikTok Business credentials are not TikTok Display API credentials."
    },
    {
      "area": "instagram-owned-tracking",
      "state": "missing-user-credential",
      "missing": [
        "SCRAPECREATORS_API_KEY"
      ]
    },
    {
      "area": "discord-automation",
      "state": "bot-ready-oauth-missing",
      "available": [
        "validated DISCORD_CLIENT_ID",
        "validated DISCORD_TOKEN",
        "GoTall Creators guild ID",
        "onboarding, active, at-risk, and top-performer role IDs"
      ],
      "missing": [
        "DISCORD_CLIENT_SECRET",
        "registered DISCORD_OAUTH_REDIRECT_URI"
      ],
      "notes": "The existing GoTall bot authenticated successfully. Its managed role must be moved above any lifecycle role it will assign."
    },
    {
      "area": "transactional-email",
      "state": "available",
      "notes": "The Resend API key authenticated successfully and gotall.app is a verified sending domain. Use a GoTall sender address rather than coupling email identity to gethyperspeed.com."
    },
    {
      "area": "collector-cloud-ingestion",
      "state": "must-generate",
      "missing": [
        "CREATOR_INGEST_CURRENT_KEY_ID",
        "CREATOR_INGEST_CURRENT_SECRET_B64"
      ],
      "notes": "Generate a new ingestion-only key. Do not reuse AUTH_SECRET or CRON_SECRET."
    },
    {
      "area": "payments",
      "state": "provider-decision-required",
      "missing": [
        "PAYMENT_PROVIDER",
        "payment provider server credentials",
        "payment webhook signing secret"
      ]
    },
    {
      "area": "agreements",
      "state": "provider-decision-required",
      "missing": [
        "E_SIGNATURE_PROVIDER",
        "e-signature API credentials and webhook secret"
      ]
    },
    {
      "area": "official-instagram-oauth",
      "state": "future-credential",
      "missing": [
        "META_APP_ID",
        "META_APP_SECRET",
        "META_OAUTH_REDIRECT_URI"
      ]
    },
    {
      "area": "official-tiktok-creator-oauth",
      "state": "future-credential",
      "missing": [
        "TikTok Login Kit or Display API client credentials and approved redirect URI"
      ]
    }
  ]
}
