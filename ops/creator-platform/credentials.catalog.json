  "platformRequirements": [
    {
      "area": "creator-web-core",
      "state": "dedicated-account-backend-live",
      "available": [
        "dedicated gotall-creator-platform Supabase project",
        "RLS-protected account, application, enrollment, and agreement schema",
        "production URL, publishable key, and server key in Vercel",
        "confirmed email/password authentication configuration"
      ],
      "notes": "The creator account backend is isolated from the legacy CRM and the consumer GoTall user pool. Production runtime values remain authoritative in Vercel."
    },
    {
      "area": "domain-and-hosting",
      "state": "available",
      "notes": "Cloudflare API, Vercel CLI, and Hyperspeed VPS SSH access are present."
    },
    {
      "area": "source-control",
      "state": "missing-user-session",
      "missing": [
        "valid GitHub CLI or Git HTTPS authentication for arksomething"
      ],
      "notes": "The stored GitHub CLI and HTTPS credentials are rejected, and SSH authentication is not registered. Local commits cannot be pushed until interactive reauthentication."
    },
    {
      "area": "tiktok-owned-tracking",
      "state": "in-progress",
      "notes": "Public collector/runtime work is being handled separately. Existing TikTok Business credentials are not TikTok Display API credentials."
    },
    {
      "area": "instagram-owned-tracking",
      "state": "credential-and-guard-live-capacity-gated",
      "available": [
        "SCRAPECREATORS_API_KEY",
        "validated direct-post adapter",
        "validated bounded profile discovery",
        "29 complete direct observations",
        "persisted fail-closed 100-credit reserve"
      ],
      "missing": [
        "adequate recurring ScrapeCreators credit capacity"
      ],
      "notes": "The credential is owner-only and passed identity/counter validation. The durable guard is blocked at the configured 100-credit reserve with 95 last observed. Recurring Instagram timers stay disabled because the balance is below the existing backlog and daily operating requirement."
    },
    {
      "area": "discord-automation",
      "state": "oauth-configured-rotation-required",
      "available": [
        "validated GoTall - Management client ID",
        "validated Hermes DISCORD_BOT_TOKEN",
        "sensitive DISCORD_CLIENT_SECRET in gotall-creator-platform Vercel production",
        "registered OAuth redirect URI",
        "GoTall Creators and GoTall Community guild IDs",
        "onboarding, active, at-risk, and top-performer role IDs"
      ],
      "missing": [
        "rotation of the chat-exposed DISCORD_CLIENT_SECRET before launch",
        "deployed OAuth callback handler",
        "corrected bot-role hierarchy"
      ],
      "notes": "GoTall - Management is the live reboot-persistent Hermes application and replaces the legacy GoTall bot for the new platform. Keep creator OAuth, deterministic role synchronization, and the Hermes LLM gateway as separate trust lanes."
    },
    {
      "area": "transactional-email",
      "state": "creator-auth-smtp-live",
      "available": [
        "verified gotall.app sending domain",
        "Resend custom SMTP on the dedicated creator Supabase project",
        "accounts@gotall.app auth sender"
      ],
      "notes": "Creator confirmation and password-reset mail uses accounts@gotall.app through Resend SMTP; the Resend key is not copied into the Vercel web runtime."
    },
    {
      "area": "collector-cloud-ingestion",
      "state": "must-generate",
      "missing": [
        "CREATOR_INGEST_CURRENT_KEY_ID",
        "CREATOR_INGEST_CURRENT_SECRET_B64"
      ],
      "notes": "Generate a new ingestion-only key. Do not reuse AUTH_SECRET or CRON_SECRET."
    },
    {
      "area": "payments",
      "state": "provider-decision-required",
      "missing": [
        "PAYMENT_PROVIDER",
        "payment provider server credentials",
        "payment webhook signing secret"
      ]
    },
    {
      "area": "agreements",
      "state": "signwell-key-installed-adapter-pending",
      "available": [
        "provider-neutral agreement and event ledger",
        "SignWell selected for low-volume multi-party creator agreements",
        "sensitive AGREEMENT_API_KEY in gotall-creator-platform Vercel production",
        "read-only SignWell account request verified successfully"
      ],
      "missing": [
        "rotation of the chat-exposed SignWell API key before live signing",
        "verified webhook secret",
        "approved agreement template and immutable terms version",
        "legal review of creator and guardian signature requirements"
      ],
      "notes": "DocuSign was explicitly rejected. The supplied SignWell key is stored but must be rotated before live signing because it was pasted into chat; no runtime adapter or signing route uses it yet. Do not treat clickwrap as the bilateral creator contract without counsel approval."
    },
    {
      "area": "official-instagram-oauth",
      "state": "future-credential",
      "missing": [
        "META_APP_ID",
        "META_APP_SECRET",
        "META_OAUTH_REDIRECT_URI"
      ]
    },
    {
      "area": "official-tiktok-creator-oauth",
      "state": "future-credential",
      "missing": [
        "TikTok Login Kit or Display API client credentials and approved redirect URI"
      ]
    }
  ]
