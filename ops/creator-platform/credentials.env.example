# This is a contract, not a file to fill with every secret on the host.
# Production web secrets belong in the new Vercel project. Laptop-only provider
# and ingestion credentials belong in owner-only service credential files.

# Dedicated creator account backend. Production values are already installed in
# the gotall-creator-platform Vercel project; this block is for local work only.
APP_ORIGIN=https://gotall-creator-platform.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Already installed owner-only on the collector. Keep this blank contract entry
# so rotations never copy the live value into the repository.
SCRAPECREATORS_API_KEY=
INSTAGRAM_PROVIDER_CREDIT_RESERVE=100

# GoTall - Management is the live Hermes application and the v1 OAuth client.
DISCORD_CLIENT_ID=1534630446959427686
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1400610531189985310
DISCORD_GUILD_INVITE_URL=https://discord.gg/tTYXKu4kDj
DISCORD_ONBOARDING_ROLE_ID=1505873205846478848
DISCORD_ACTIVE_ROLE_ID=1502369330254446602
DISCORD_AT_RISK_ROLE_ID=1505873740506988595
DISCORD_TOP_PERFORMER_ROLE_ID=1502367775845515295
DISCORD_OAUTH_REDIRECT_URI=https://gethyperspeed.com/api/integrations/discord/callback
# Generated once and shared only between Vercel and the host-encrypted worker credential.
DISCORD_REMINDER_WORKER_SECRET=

# Dedicated HMAC trust boundary for the laptop tracker delivery outbox. The
# previous pair is optional and supports a no-downtime key rotation. Never
# reuse an auth, cron, Discord, or provider secret here.
CREATOR_INGEST_ALLOWED_ORGANIZATION_IDS=org_public_tt_ads_manager
CREATOR_INGEST_CURRENT_KEY_ID=
CREATOR_INGEST_CURRENT_SECRET_B64=
CREATOR_INGEST_PREVIOUS_KEY_ID=
CREATOR_INGEST_PREVIOUS_SECRET_B64=

# Server-only normalized tracker store. These belong only in the isolated
# creator-platform Vercel project; the laptop delivery role never receives them.
CREATOR_TRACKER_V2_DATABASE_URL=
CREATOR_TRACKER_V2_DATABASE_CA_B64=

# Dedicated HMAC key for the campaign-account bio-verification worker API.
# Generate 32-128 random bytes and store their canonical base64 form in Vercel
# and the future host-encrypted worker credential. Do not reuse ingestion,
# Discord, provider, auth, or cron credentials.
CREATOR_VERIFICATION_WORKER_SECRET_B64=

# These depend on product/provider decisions; do not invent placeholder secrets.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
AGREEMENT_PROVIDER=signwell
AGREEMENT_API_KEY=
# SignWell uses the webhook resource ID as the HMAC key for event.hash.
AGREEMENT_WEBHOOK_SECRET=
# Obsolete and ignored: AGREEMENT_TEMPLATE_ID,
# AGREEMENT_TEMPLATE_TERMS_SHA256, and
# AGREEMENT_TEMPLATE_DEAL_SNAPSHOT_SHA256. The exactly-one verified production
# binding stored for each immutable deal version is authoritative.
AGREEMENT_CREATOR_PLACEHOLDER=Creator
# Completed documents are private and include the SignWell audit page.
AGREEMENT_ARCHIVE_ENABLED=false
# Keep false until the exposed API key is rotated and the legal template is approved.
AGREEMENT_SEND_ENABLED=false
AGREEMENT_TEST_MODE=true
AGREEMENT_LIVE_MODE_APPROVED=false

# Future first-party OAuth path. ScrapeCreators remains the immediate public
# Instagram collection credential.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://gethyperspeed.com/api/integrations/instagram/callback
