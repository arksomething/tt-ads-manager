[Unit]
Description=GoTall creator Discord reminder and role worker
Documentation=https://gotall-creator-platform.vercel.app/api/health
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gotall-discord
Group=gotall-discord
WorkingDirectory=/var/lib/gotall-creator-discord-worker
ExecStart=/usr/local/lib/gotall-creator-discord-worker/node /usr/local/lib/gotall-creator-discord-worker/worker.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
Environment=CREATOR_DISCORD_API_ORIGIN=https://gotall-creator-platform.vercel.app
Environment=CREATOR_DISCORD_WORKER_ID=gotall-xps-discord-worker
Environment=CREATOR_DISCORD_JOURNAL_PATH=/var/lib/gotall-creator-discord-worker/journal.sqlite3
Environment=DISCORD_GUILD_ID=1400610531189985310
Environment=DISCORD_ONBOARDING_ROLE_ID=1505873205846478848
Environment=DISCORD_ACTIVE_ROLE_ID=1502369330254446602
Environment=DISCORD_AT_RISK_ROLE_ID=1505873740506988595
Environment=DISCORD_TOP_PERFORMER_ROLE_ID=1502367775845515295
LoadCredentialEncrypted=discord-bot-token:/etc/credstore.encrypted/gotall-creator-discord-bot-token.cred
LoadCredentialEncrypted=discord-worker-secret:/etc/credstore.encrypted/gotall-creator-discord-worker-secret.cred
StateDirectory=gotall-creator-discord-worker
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
